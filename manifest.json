{
  "schemaVersion": 1,
  "id": "io.github.biplop.fwupd",
  "name": "Firmware Updates",
  "version": "0.3.0",
  "author": "Biplop",
  "license": "MIT",
  "description": "Checks LVFS firmware updates with fwupdmgr and provides an explicit install action.",
  "homepage": "https://github.com/B33pl0p/omarchy-fwupd",
  "kinds": ["bar-widget"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Firmware Updates",
    "description": "Shows pending fwupd firmware updates",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 604800
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 300,
        "max": 2592000,
        "step": 3600,
        "defaultValue": 604800
      }
    ]
  }
}
